# Copy to .env.local. These browser settings are public, never secrets.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional: explicitly preview sample data even when credentials exist.
VITE_DEMO_MODE=false

# Public Cloudflare Turnstile site key for anonymous review submissions.
VITE_TURNSTILE_SITE_KEY=
